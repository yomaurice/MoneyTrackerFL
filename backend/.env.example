# Copy to .env for local development. .env is git-ignored; never commit it.
# In production these are set in Render's environment, not in a file.

# Local Postgres. Leave commented to avoid touching the production database.
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/money_tracker

# At least 32 random bytes. Signs every auth token.
SECRET_KEY=

# Builds password-reset links.
FRONTEND_URL=http://localhost:3000

# Password-reset email.
RESEND_API_KEY=

# Chat assistant. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides; defaults are gemini-flash-latest / gemini-flash-lite-latest.
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=
